{
  "name": "avalia-api",
  "version": "1.0.0",
  "description": "API REST do Avalia+ (PIM IV): autenticação, cadastros, banco de questões, simulados, desempenho e gamificação.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "mssql": "12.7.13",
    "multer": "2.5.0",
    "nodemailer": "6.10.1"
  }
}
