# Avalia+ API — modelo de configuração
# Copie este arquivo para .env e preencha os valores. O .env NUNCA vai para o Git.

# Porta da API e endereço público (usado para montar o endereço completo das imagens)
PORTA=3000
URL_PUBLICA=http://localhost:3000

# String de conexão do Azure SQL (a mesma do appsettings.Local.json da Desktop).
# Portal do Azure > banco "avalia" > Cadeias de conexão > ADO.NET
# IMPORTANTE: mantenha as ASPAS. Sem elas, uma senha com # é cortada (o # vira comentário).
DB_CONEXAO="Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=avalia;Persist Security Info=False;User ID=<usuario>;Password=<senha>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;"

# Segredo do token JWT: texto aleatório com 32 caracteres ou mais.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=
# Prazo único do token (7 dias atende também o aplicativo móvel)
JWT_PRAZO=7d

# Validade do código de recuperação de senha, em minutos (RN03)
CODIGO_VALIDADE_MINUTOS=15

# E-mail: "log" mostra o e-mail no console (padrão); "smtp" envia de verdade
EMAIL_MODO=log
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Avalia+ <nao-responda@avaliamais.test>

# Pasta onde ficam as imagens enviadas (fora do Git)
PASTA_UPLOADS=uploads

# Pasta da aplicação web servida pela API (deixe vazio para não servir)
PASTA_WEB=../web

# Outras origens que podem chamar a API pelo navegador (ex.: Live Server do VS Code), separadas por vírgula
ORIGENS_PERMITIDAS=http://127.0.0.1:5500,http://localhost:5500
